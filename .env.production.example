# Production template. Copy to .env on the server and fill in every value.
# Never commit real values.

APP_NAME="Freelance Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Daily files, warnings and above. Business events always go to their own file (storage/logs/business-*.log).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_BUSINESS_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated emails allowed into /admin. They also need email multi-factor authentication enabled.
ADMIN_EMAILS=

API_RATE_LIMIT_PER_MINUTE=60
MCP_RATE_LIMIT_PER_MINUTE=60
API_TOKEN_DEFAULT_EXPIRY_DAYS=90

INVITATION_EXPIRY_DAYS=7
COMMENTS_POLL_INTERVAL=30s

SECURITY_CSP_ENABLED=true

BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=14
# BACKUP_MYSQLDUMP_PATH=

VITE_APP_NAME="${APP_NAME}"
